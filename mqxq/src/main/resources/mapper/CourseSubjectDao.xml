<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jieni.mqxq.dao.CourseSubjectDao">

    <resultMap type="com.jieni.mqxq.domain.entity.CourseSubject" id="CourseSubjectMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="parentId" column="parent_id" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="createUser" column="create_user" jdbcType="INTEGER"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="updateUser" column="update_user" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 通用字段SQL片段 -->
    <sql id="Base_Column_List">
        id, name, parent_id, create_time, create_user, update_time, update_user
    </sql>

    <!-- 通用查询条件SQL片段 -->
    <sql id="Base_Where_Clause">
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="parentId != null">
                AND parent_id = #{parentId}
            </if>
        </where>
    </sql>

    <!--查询单个-->
    <select id="queryById" resultMap="CourseSubjectMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM course_subject
        WHERE id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="CourseSubjectMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM course_subject
        <include refid="Base_Where_Clause"/>
        ORDER BY create_time DESC
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM course_subject
        <include refid="Base_Where_Clause"/>
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO course_subject(name, parent_id, create_time, create_user, update_time, update_user)
        VALUES (
            #{name},
            <choose>
                <when test="parentId != null">#{parentId}</when>
                <otherwise>0</otherwise>
            </choose>,
            #{createTime},
            <choose>
                <when test="createUser != null">#{createUser}</when>
                <otherwise>1</otherwise>
            </choose>,
            #{updateTime},
            <choose>
                <when test="updateUser != null">#{updateUser}</when>
                <otherwise>1</otherwise>
            </choose>
        )
    </insert>

    <!--批量新增-->
    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO course_subject(name, parent_id, create_time, create_user, update_time, update_user)
        VALUES
        <foreach collection="entities" item="entity" separator=",">
            (
                #{entity.name},
                <choose>
                    <when test="entity.parentId != null">#{entity.parentId}</when>
                    <otherwise>0</otherwise>
                </choose>,
                #{entity.createTime},
                <choose>
                    <when test="entity.createUser != null">#{entity.createUser}</when>
                    <otherwise>1</otherwise>
                </choose>,
                #{entity.updateTime},
                <choose>
                    <when test="entity.updateUser != null">#{entity.updateUser}</when>
                    <otherwise>1</otherwise>
                </choose>
            )
        </foreach>
    </insert>

    <!--批量新增或更新-->
    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO course_subject(name, parent_id, create_time, create_user, update_time, update_user)
        VALUES
        <foreach collection="entities" item="entity" separator=",">
            (
                #{entity.name},
                #{entity.parentId},
                #{entity.createTime},
                #{entity.createUser},
                #{entity.updateTime},
                #{entity.updateUser}
            )
        </foreach>
        ON DUPLICATE KEY UPDATE
            name = VALUES(name),
            parent_id = VALUES(parent_id),
            create_time = VALUES(create_time),
            create_user = VALUES(create_user),
            update_time = VALUES(update_time),
            update_user = VALUES(update_user)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        UPDATE course_subject
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="parentId != null">
                parent_id = #{parentId},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateUser != null">
                update_user = #{updateUser},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        DELETE FROM course_subject WHERE id = #{id}
    </delete>

</mapper>
