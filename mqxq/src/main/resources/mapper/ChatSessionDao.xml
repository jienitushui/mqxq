<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jieni.mqxq.dao.ChatSessionDao">

    <resultMap type="com.jieni.mqxq.domain.entity.ChatSession" id="ChatSessionMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="sessionId" column="session_id" jdbcType="VARCHAR"/>
        <result property="userId" column="user_id" jdbcType="INTEGER"/>
        <result property="title" column="title" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="createrUser" column="create_user" jdbcType="INTEGER"/>
        <result property="updaterUser" column="updater_user" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 新增所有列 -->
    <insert id="save" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO chat_session (session_id, user_id, title, create_time, update_time, create_user, updater_user)
        VALUES (#{sessionId}, #{userId}, #{title}, #{createTime}, #{updateTime}, #{createrUser}, #{updaterUser})
    </insert>

    <!-- 根据sessionId查询会话 -->
    <select id="selectBySessionId" resultMap="ChatSessionMap">
        SELECT id, session_id, user_id, title, create_time, update_time, create_user, updater_user
        FROM chat_session
        WHERE session_id = #{sessionId}
        LIMIT 1
    </select>

    <!-- 根据id更新会话 -->
    <update id="updateById">
        UPDATE chat_session
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updaterUser != null">updater_user = #{updaterUser},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据用户ID查询会话列表 -->
    <select id="selectByUserId" resultMap="ChatSessionMap">
        SELECT id, session_id, user_id, title, create_time, update_time, create_user, updater_user
        FROM chat_session
        WHERE user_id = #{userId}
        ORDER BY update_time DESC
    </select>

    <!-- 根据sessionId删除会话 -->
    <delete id="deleteBySessionId">
        DELETE FROM chat_session
        WHERE session_id = #{sessionId}
    </delete>

</mapper>

