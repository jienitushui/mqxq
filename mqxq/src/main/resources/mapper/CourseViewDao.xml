<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jieni.mqxq.dao.CourseViewDao">

    <!-- 结果映射 -->
    <resultMap type="com.jieni.mqxq.domain.entity.CourseView" id="CourseViewMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="courseId" column="course_id" jdbcType="INTEGER"/>
        <result property="userId" column="user_id" jdbcType="INTEGER"/>
        <result property="viewTime" column="view_time" jdbcType="TIMESTAMP"/>
        <result property="ipAddress" column="ip_address" jdbcType="VARCHAR"/>
        <result property="userAgent" column="user_agent" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 通用字段列表 -->
    <sql id="Base_Column_List">
        id, course_id, user_id, view_time, ip_address, user_agent, create_time
    </sql>

    <!-- 通用查询条件 -->
    <sql id="Base_Where_Clause">
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="courseId != null">
                AND course_id = #{courseId}
            </if>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="viewTime != null">
                AND view_time = #{viewTime}
            </if>
            <if test="ipAddress != null and ipAddress != ''">
                AND ip_address LIKE CONCAT('%', #{ipAddress}, '%')
            </if>
            <if test="userAgent != null and userAgent != ''">
                AND user_agent LIKE CONCAT('%', #{userAgent}, '%')
            </if>
            <if test="createTime != null">
                AND create_time = #{createTime}
            </if>
        </where>
    </sql>

    <!-- 查询单个 -->
    <select id="queryById" resultMap="CourseViewMap">
        SELECT <include refid="Base_Column_List"/>
        FROM course_view
        WHERE id = #{id}
    </select>

    <!-- 查询指定行数据 -->
    <select id="queryAllByLimit" resultMap="CourseViewMap">
        SELECT <include refid="Base_Column_List"/>
        FROM course_view
        <include refid="Base_Where_Clause"/>
        ORDER BY view_time DESC, id DESC
    </select>

    <!-- 统计总行数 -->
    <select id="count" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM course_view
        <include refid="Base_Where_Clause"/>
    </select>

    <!-- 新增单条记录 -->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO course_view(course_id, user_id, view_time, ip_address, user_agent, create_time)
        VALUES (#{courseId}, #{userId}, #{viewTime}, #{ipAddress}, #{userAgent}, #{createTime})
    </insert>

    <!-- 批量新增 -->
    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO course_view(course_id, user_id, view_time, ip_address, user_agent, create_time)
        VALUES
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.courseId}, #{entity.userId}, #{entity.viewTime}, #{entity.ipAddress}, #{entity.userAgent}, #{entity.createTime})
        </foreach>
    </insert>

    <!-- 批量新增或更新 -->
    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO course_view(course_id, user_id, view_time, ip_address, user_agent, create_time)
        VALUES
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.courseId}, #{entity.userId}, #{entity.viewTime}, #{entity.ipAddress}, #{entity.userAgent}, #{entity.createTime})
        </foreach>
        ON DUPLICATE KEY UPDATE
            course_id = VALUES(course_id),
            user_id = VALUES(user_id),
            view_time = VALUES(view_time),
            ip_address = VALUES(ip_address),
            user_agent = VALUES(user_agent),
            create_time = VALUES(create_time)
    </insert>

    <!-- 通过主键修改数据 -->
    <update id="update">
        UPDATE course_view
        <set>
            <if test="courseId != null">
                course_id = #{courseId},
            </if>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="viewTime != null">
                view_time = #{viewTime},
            </if>
            <if test="ipAddress != null and ipAddress != ''">
                ip_address = #{ipAddress},
            </if>
            <if test="userAgent != null and userAgent != ''">
                user_agent = #{userAgent},
            </if>
            <if test="createTime != null">
                create_time = #{createTime},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 通过主键删除 -->
    <delete id="deleteById">
        DELETE FROM course_view
        WHERE id = #{id}
    </delete>

    <!-- 通过主键列表批量删除 -->
    <delete id="deleteByIds">
        DELETE FROM course_view
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>

