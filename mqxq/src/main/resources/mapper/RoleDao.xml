<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jieni.mqxq.dao.RoleDao">

    <!-- 结果映射 -->
    <resultMap type="com.jieni.mqxq.domain.entity.Role" id="RoleMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="roleName" column="role_name" jdbcType="VARCHAR"/>
        <result property="roleCode" column="role_code" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 通用字段列表 -->
    <sql id="Base_Column_List">
        id, role_name, role_code, create_time, update_time
    </sql>

    <!-- 通用查询条件（模糊查询） -->
    <sql id="Query_Condition">
        <if test="role != null">
            <if test="role.id != null">
                AND id = #{role.id}
            </if>
            <if test="role.roleName != null and role.roleName != ''">
                AND role_name LIKE CONCAT('%', #{role.roleName}, '%')
            </if>
            <if test="role.roleCode != null and role.roleCode != ''">
                AND role_code LIKE CONCAT('%', #{role.roleCode}, '%')
            </if>
        </if>
    </sql>

    <!-- 根据ID查询单条数据 -->
    <select id="queryById" resultMap="RoleMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM role
        WHERE id = #{id}
    </select>

    <!-- 根据角色代码查询角色 -->
    <select id="queryByRoleCode" resultMap="RoleMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM role
        WHERE role_code = #{roleCode}
        LIMIT 1
    </select>

    <!-- 查询所有角色 -->
    <select id="queryAll" resultMap="RoleMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM role
        ORDER BY id ASC
    </select>

    <!-- 根据条件查询角色列表（支持模糊查询） -->
    <select id="queryAllByCondition" resultMap="RoleMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM role
        <where>
            <include refid="Query_Condition"/>
        </where>
        ORDER BY id ASC
    </select>

    <!-- 统计符合条件的角色总数 -->
    <select id="count" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM role
        <where>
            <include refid="Query_Condition"/>
        </where>
    </select>

    <!-- 新增角色数据 -->
    <insert id="insert" keyProperty="role.id" useGeneratedKeys="true">
        INSERT INTO role (role_name, role_code, create_time, update_time)
        VALUES (#{role.roleName}, #{role.roleCode}, #{role.createTime}, #{role.updateTime})
    </insert>

    <!-- 批量新增角色数据 -->
    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO role (role_name, role_code, create_time, update_time)
        VALUES
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.roleName}, #{entity.roleCode}, #{entity.createTime}, #{entity.updateTime})
        </foreach>
    </insert>

    <!-- 批量新增或按主键更新角色数据 -->
    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO role (role_name, role_code, create_time, update_time)
        VALUES
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.roleName}, #{entity.roleCode}, #{entity.createTime}, #{entity.updateTime})
        </foreach>
        ON DUPLICATE KEY UPDATE
            role_name = VALUES(role_name),
            role_code = VALUES(role_code),
            update_time = VALUES(update_time)
    </insert>

    <!-- 更新角色数据 -->
    <update id="update">
        UPDATE role
        <set>
            <if test="role.roleName != null and role.roleName != ''">
                role_name = #{role.roleName},
            </if>
            <if test="role.roleCode != null and role.roleCode != ''">
                role_code = #{role.roleCode},
            </if>
            <if test="role.updateTime != null">
                update_time = #{role.updateTime},
            </if>
        </set>
        WHERE id = #{role.id}
    </update>

    <!-- 根据ID删除角色 -->
    <delete id="deleteById">
        DELETE FROM role WHERE id = #{id}
    </delete>

    <!-- 批量删除角色 -->
    <delete id="deleteBatch">
        DELETE FROM role
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
